# ==============================================================================
# ARUNA Production Monitoring System — Safe Environment Configuration Template
# DO NOT store real passwords, credentials, or private keys in this file.
# Copy this file to .env and configure values appropriate for your environment.
# ==============================================================================

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=aruna_textiles

# Flask Security Configuration
FLASK_SECRET_KEY=replace_with_a_cryptographically_secure_random_string_64_chars_min
FLASK_ENV=development
PORT=5000
WS_PORT=5001

# Production Flags (Set COOKIE_SECURE=true when running under HTTPS)
COOKIE_SECURE=false
